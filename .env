# expo-router is pulled in as an optional peer dependency of @expo/cli even though
# this app uses React Navigation instead. Without this flag, `expo start`/`expo export`
# refuse to bundle because they detect expo-router + react-navigation together.
# See: https://docs.expo.dev/router/migrate/sdk-55-to-56/
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1